{
  "name": "night-relay",
  "version": "4.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "api:dev": "node --env-file=.env.local --import tsx scripts/dev.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --import tsx --test src/game/*.test.ts server/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "node --env-file=.env.local --import tsx scripts/migrate.ts",
    "test:leaderboard": "node --env-file=.env.test.local --import tsx scripts/check-leaderboard.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/three": "^0.180.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
  },
  "description": "A real-time 3D light relay through Samarkand, built with Three.js and TypeScript.",
  "license": "MIT",
  "author": {
    "name": "Mukhsin Mukhtorov",
    "url": "https://github.com/Mukhsin0508"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Mukhsin0508/night-relay.git"
  },
  "homepage": "https://night-relay-samarkand.vercel.app/",
  "bugs": {
    "url": "https://github.com/Mukhsin0508/night-relay/issues"
  },
  "engines": {
    "node": "^22.16.0 || ^24.0.0"
  }
}
