# Python & Virtual Environments
backend/.venv/
backend/__pycache__/
__pycache__/
*.py[cod]

# Logs & Environment
.logs/
logs/
*.log
.env
.env.*
!.env.example

# Temporary Files & Backups
*.bak
*.bak*
*.backup
*.tmp
*.temp
*.swp
*.swo
*~
*.zip
*.tar
*.gz

# Scratchpads & Test Scripts
scratch/
