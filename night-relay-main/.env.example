# Optional. The game runs without these; shared rankings need your own Neon database.
# Copy to .env.local, then paste connection URLs from your Neon project.
DATABASE_URL=

# A direct, non-pooler connection is required for npm run db:migrate.
DATABASE_URL_UNPOOLED=

# Integration tests use a separate .env.test.local with all three URLs set to
# an isolated test database. Never point this at production.
# LEADERBOARD_TEST_DATABASE_URL=
